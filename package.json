{
  "name": "deepchat",
  "version": "1.21.0",
  "description": "基于 DeepSeek API 的聊天客户端，提供 Web 与 Android 版本。",
  "license": "MIT",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "rspack serve -c rspack.config.ts",
    "build": "cross-env NODE_ENV=production rspack build -c rspack.config.ts && node scripts/strip-fonts.mjs",
    "apk": "pnpm build && pnpm exec cap sync android && cd android && gradlew.bat assembleDebug --no-daemon",
    "apk:release": "pnpm build && pnpm exec cap sync android && cd android && gradlew.bat assembleRelease --offline --no-daemon",
    "release:check": "node scripts/release-check.mjs",
    "release:package": "node scripts/package-release.mjs",
    "type": "tsc -p tsconfig.json",
    "test:context": "node --test scripts/chat-context.test.mjs",
    "test:scroll": "node --test scripts/chat-scroll.test.mjs",
    "test:motion": "node --test scripts/motion.test.mjs",
    "test:settings": "node --test scripts/settings.test.mjs",
    "test:math": "node --test scripts/markdown-math.test.mjs",
    "test:images": "node --test scripts/image-workbench.test.mjs",
    "test:pricing": "node --test scripts/pricing.test.mjs",
    "test:share-card": "node --test scripts/share-card.test.mjs",
    "test": "pnpm test:context && pnpm test:scroll && pnpm test:motion && pnpm test:settings && pnpm test:math && pnpm test:images && pnpm test:pricing && pnpm test:share-card",
    "lint": "oxlint src rspack.config.ts",
    "format": "oxfmt --write ."
  },
  "dependencies": {
    "@capacitor/android": "9.0.0-rc.0",
    "@capacitor/app": "9.0.0-alpha.2",
    "@capacitor/core": "9.0.0-rc.0",
    "@types/katex": "^0.16.5",
    "@types/mdast": "~4.0.3",
    "@types/prismjs": "^1.26.1",
    "@types/react": "~18.3.1",
    "@types/react-dom": "~18.3.0",
    "clsx": "2.1.1",
    "fflate": "0.8.3",
    "idb": "8.0.3",
    "katex": "0.16.22",
    "mdast-util-find-and-replace": "3.0.2",
    "mdast-util-from-markdown": "2.0.3",
    "mdast-util-gfm": "3.1.0",
    "mdast-util-math": "3.0.0",
    "mermaid": "11.10.1",
    "micromark-extension-gfm": "3.0.0",
    "micromark-extension-llm-math": "3.1.0",
    "prismjs": "1.30.0",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "zustand": "4.4.7"
  },
  "devDependencies": {
    "@capacitor/cli": "9.0.0-rc.0",
    "@rspack/cli": "2.0.2",
    "@rspack/core": "2.0.2",
    "@rspack/dev-server": "2.0.1",
    "@swc/helpers": "0.5.23",
    "@types/node": "~20.9.2",
    "cross-env": "^10.1.0",
    "oxfmt": "0.48.0",
    "oxlint": "1.63.0",
    "typescript": "7.0.2"
  }
}
